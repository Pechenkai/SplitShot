POSTGRES_USER=splitshot
POSTGRES_PASSWORD=splitshot
POSTGRES_DB=splitshot
POSTGRES_MULTIPLE_DATABASES=splitshot_test
POSTGRES_PORT=5433
BACKEND_PORT=8002

# Host URLs are for commands run directly on the developer machine.
DATABASE_URL=postgresql+asyncpg://splitshot:splitshot@localhost:5433/splitshot
TEST_DATABASE_URL=postgresql+asyncpg://splitshot:splitshot@localhost:5433/splitshot_test

# Container URLs are used by docker-compose backend via the internal Docker network.
BACKEND_DATABASE_URL=postgresql+asyncpg://splitshot:splitshot@db:5432/splitshot
BACKEND_TEST_DATABASE_URL=postgresql+asyncpg://splitshot:splitshot@db:5432/splitshot_test
